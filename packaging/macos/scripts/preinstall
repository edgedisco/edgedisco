#!/bin/sh
set -eu

DAEMON_LABEL="com.edgedisco.daemon"
AGENT_LABEL="com.edgedisco.agent"
STAGED_ROOT=${EDGEDISCO_STAGED_ROOT:-}
LIFECYCLE_LOG=${EDGEDISCO_LIFECYCLE_LOG:-}

if [ -n "$STAGED_ROOT" ]; then
    case "$STAGED_ROOT" in
        /*) ;;
        *) printf '%s\n' "EDGEDISCO_STAGED_ROOT must be an absolute path" >&2; exit 64 ;;
    esac
    if [ "$STAGED_ROOT" = "/" ]; then
        printf '%s\n' "EDGEDISCO_STAGED_ROOT must not be /" >&2
        exit 64
    fi
    if [ ! -d "$STAGED_ROOT" ] || [ -L "$STAGED_ROOT" ]; then
        printf '%s\n' "EDGEDISCO_STAGED_ROOT must be an existing canonical directory, not a symlink" >&2
        exit 64
    fi
    canonical_root=$(CDPATH= cd "$STAGED_ROOT" && pwd -P)
    if [ "$canonical_root" != "$STAGED_ROOT" ]; then
        printf '%s\n' "EDGEDISCO_STAGED_ROOT must be canonical" >&2
        exit 64
    fi
    ROOT=$STAGED_ROOT
    STAGED=1
else
    if [ "$(id -u)" -ne 0 ]; then
        printf '%s\n' "EdgeDisco package scripts require root" >&2
        exit 77
    fi
    ROOT=
    STAGED=0
fi

for protected_path in \
    "$ROOT/Library" \
    "$ROOT/Library/Application Support" \
    "$ROOT/Library/Application Support/EdgeDisco" \
    "$ROOT/Library/Application Support/EdgeDisco/config" \
    "$ROOT/Library/Application Support/EdgeDisco/config/daemon.json" \
    "$ROOT/Library/Application Support/EdgeDisco/logs" \
    "$ROOT/Library/Application Support/EdgeDisco/data" \
    "$ROOT/Library/LaunchDaemons" \
    "$ROOT/Library/LaunchDaemons/com.edgedisco.daemon.plist" \
    "$ROOT/Library/LaunchAgents" \
    "$ROOT/Library/LaunchAgents/com.edgedisco.agent.plist" \
    "$ROOT/usr" \
    "$ROOT/usr/local" \
    "$ROOT/usr/local/libexec" \
    "$ROOT/usr/local/libexec/edgedisco" \
    "$ROOT/usr/local/libexec/edgedisco/edgedisco"
do
    if [ -L "$protected_path" ]; then
        printf 'refusing symlink in package-owned path: %s\n' "$protected_path" >&2
        exit 65
    fi
done

# Import operator tuning from the old package-owned plist once. Keep the
# original plist as a recovery reference; never replace an existing config.
support="$ROOT/Library/Application Support/EdgeDisco"
old_plist="$ROOT/Library/LaunchDaemons/$DAEMON_LABEL.plist"
config="$support/config/daemon.json"
if [ -f "$old_plist" ] && [ ! -e "$config" ]; then
    plutil -lint "$old_plist" >/dev/null
    [ "$(plutil -type ProgramArguments "$old_plist")" = "array" ] || {
        printf '%s\n' "existing daemon plist has no ProgramArguments array; refusing settings loss" >&2
        exit 65
    }
    mkdir -p "$support/config"
    chmod 0750 "$support" "$support/config"
    work=$(mktemp -d "$support/config/upgrade.XXXXXX")
    trap 'rm -rf "$work"' EXIT HUP INT TERM
    cp "$old_plist" "$work/previous-daemon.plist"
    plutil -create xml1 "$work/daemon.json"
    plutil -insert schema_version -integer 1 "$work/daemon.json"
    index=0
    while value=$(plutil -extract "ProgramArguments.$index" raw -o - "$old_plist" 2>/dev/null); do
        index=$((index + 1))
        case "$value" in
            --interval) key=interval_seconds; type=integer ;;
            --otlp-endpoint) key=otlp_endpoint; type=string ;;
            --otlp-batch-size) key=otlp_batch_size; type=integer ;;
            *) continue ;;
        esac
        value=$(plutil -extract "ProgramArguments.$index" raw -o - "$old_plist")
        plutil -insert "$key" "-$type" "$value" "$work/daemon.json"
        index=$((index + 1))
    done
    plutil -convert json "$work/daemon.json"
    chmod 0600 "$work/daemon.json" "$work/previous-daemon.plist"
    # Keep each original under its unique private directory for recovery.
    mv "$work/daemon.json" "$config"
    trap - EXIT HUP INT TERM
fi

if [ "$STAGED" -eq 1 ]; then
    if [ -n "$LIFECYCLE_LOG" ]; then
        printf '%s\n' "launchctl bootout system/$DAEMON_LABEL" >> "$LIFECYCLE_LOG"
        printf '%s\n' "launchctl bootout gui/<console-uid>/$AGENT_LABEL" >> "$LIFECYCLE_LOG"
    fi
    exit 0
fi

/bin/launchctl bootout "system/$DAEMON_LABEL" >/dev/null 2>&1 || :
console_uid=$(/usr/bin/stat -f '%u' /dev/console 2>/dev/null || printf '0')
case "$console_uid" in
    ''|*[!0-9]*|0) ;;
    *) /bin/launchctl bootout "gui/$console_uid/$AGENT_LABEL" >/dev/null 2>&1 || : ;;
esac

exit 0
