#!/bin/sh
set -eu

DAEMON_LABEL="com.edgedisco.daemon"
AGENT_LABEL="com.edgedisco.agent"
STAGED_ROOT=${EDGEDISCO_STAGED_ROOT:-}
OWNERSHIP_LOG=${EDGEDISCO_OWNERSHIP_LOG:-}
LIFECYCLE_LOG=${EDGEDISCO_LIFECYCLE_LOG:-}

if [ -n "$STAGED_ROOT" ]; then
    case "$STAGED_ROOT" in
        /*) ;;
        *) printf '%s\n' "EDGEDISCO_STAGED_ROOT must be an absolute path" >&2; exit 64 ;;
    esac
    if [ "$STAGED_ROOT" = "/" ]; then
        printf '%s\n' "EDGEDISCO_STAGED_ROOT must not be /" >&2
        exit 64
    fi
    if [ ! -d "$STAGED_ROOT" ] || [ -L "$STAGED_ROOT" ]; then
        printf '%s\n' "EDGEDISCO_STAGED_ROOT must be an existing canonical directory, not a symlink" >&2
        exit 64
    fi
    canonical_root=$(CDPATH= cd "$STAGED_ROOT" && pwd -P)
    if [ "$canonical_root" != "$STAGED_ROOT" ]; then
        printf '%s\n' "EDGEDISCO_STAGED_ROOT must be canonical" >&2
        exit 64
    fi
    ROOT=$STAGED_ROOT
    STAGED=1
else
    if [ "$(id -u)" -ne 0 ]; then
        printf '%s\n' "EdgeDisco package scripts require root" >&2
        exit 77
    fi
    ROOT=
    STAGED=0
fi

support="$ROOT/Library/Application Support/EdgeDisco"
binary="$ROOT/usr/local/libexec/edgedisco/edgedisco"
daemon_plist="$ROOT/Library/LaunchDaemons/$DAEMON_LABEL.plist"
agent_plist="$ROOT/Library/LaunchAgents/$AGENT_LABEL.plist"

for protected_path in \
    "$ROOT/Library" \
    "$ROOT/Library/Application Support" \
    "$support" \
    "$support/config" \
    "$support/logs" \
    "$support/data" \
    "$ROOT/Library/LaunchDaemons" \
    "$ROOT/Library/LaunchAgents" \
    "$ROOT/usr" \
    "$ROOT/usr/local" \
    "$ROOT/usr/local/libexec" \
    "$ROOT/usr/local/libexec/edgedisco" \
    "$binary" \
    "$daemon_plist" \
    "$agent_plist"
do
    if [ -L "$protected_path" ]; then
        printf 'refusing symlink in package-owned path: %s\n' "$protected_path" >&2
        exit 65
    fi
done

for required in "$binary" "$daemon_plist" "$agent_plist"; do
    if [ ! -f "$required" ]; then
        printf 'required package payload is missing: %s\n' "$required" >&2
        exit 66
    fi
done

/bin/mkdir -p "$support/config" "$support/logs" "$support/data"
/bin/chmod 0750 "$support" "$support/config" "$support/logs"
/bin/chmod 0700 "$support/data"
/bin/chmod 0755 "$binary"
/bin/chmod 0644 "$daemon_plist" "$agent_plist"

if [ "$STAGED" -eq 1 ]; then
    if [ -n "$OWNERSHIP_LOG" ]; then
        printf '%s|root:wheel\n' "$binary" >> "$OWNERSHIP_LOG"
        printf '%s|root:wheel\n' "$daemon_plist" >> "$OWNERSHIP_LOG"
        printf '%s|root:wheel\n' "$agent_plist" >> "$OWNERSHIP_LOG"
        printf '%s|root:wheel\n' "$support" >> "$OWNERSHIP_LOG"
        printf '%s|root:wheel\n' "$support/config" >> "$OWNERSHIP_LOG"
        printf '%s|root:wheel\n' "$support/logs" >> "$OWNERSHIP_LOG"
        printf '%s|root:wheel\n' "$support/data" >> "$OWNERSHIP_LOG"
    fi
    if [ -n "$LIFECYCLE_LOG" ]; then
        printf '%s\n' "launchctl bootstrap system $daemon_plist" >> "$LIFECYCLE_LOG"
        printf '%s\n' "launchctl bootstrap gui/<console-uid> $agent_plist" >> "$LIFECYCLE_LOG"
    fi
    exit 0
fi

/usr/sbin/chown root:wheel "$binary" "$daemon_plist" "$agent_plist"
/usr/sbin/chown root:wheel "$support" "$support/config" "$support/logs" "$support/data"

# Fail installation visibly if settings or database migration are incompatible.
# Preparation does not scan, export, or bind the service socket.
"$binary" daemon --prepare --config "$support/config/daemon.json" \
    --db "$support/data/inventory.db" --ipc-mode system \
    --ipc-allowed-uid 0 --ipc-allowed-gid 20 --ipc-owner-uid 0 --ipc-group-gid 20

/bin/launchctl bootout "system/$DAEMON_LABEL" >/dev/null 2>&1 || :
/bin/launchctl bootstrap system "$daemon_plist"
"$binary" daemon --check-ready --ipc-mode system --ipc-allowed-uid 0

console_uid=$(/usr/bin/stat -f '%u' /dev/console 2>/dev/null || printf '0')
case "$console_uid" in
    ''|*[!0-9]*|0) ;;
    *)
        if /bin/launchctl print "gui/$console_uid" >/dev/null 2>&1; then
            /bin/launchctl bootout "gui/$console_uid/$AGENT_LABEL" >/dev/null 2>&1 || :
            /bin/launchctl bootstrap "gui/$console_uid" "$agent_plist"
        fi
        ;;
esac

exit 0
