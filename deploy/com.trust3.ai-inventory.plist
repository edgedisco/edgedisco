<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.trust3.ai-inventory</string>
  <key>ProgramArguments</key><array>
    <string>/Library/AIInventory/venv/bin/ai-inventory</string><string>agent</string><string>run</string>
    <string>--config</string><string>/Library/AIInventory/agent.json</string>
  </array>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Library/Logs/AIInventory.log</string>
  <key>StandardErrorPath</key><string>/Library/Logs/AIInventory.err.log</string>
</dict></plist>
