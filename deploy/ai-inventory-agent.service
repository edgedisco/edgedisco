[Unit]
Description=EdgeDisco endpoint collector for the logged-in user
After=network-online.target

[Service]
Type=simple
ExecStart=%h/.edgedisco/venv/bin/edgedisco agent run --config %h/.edgedisco/agent.json
Restart=always
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/.edgedisco

[Install]
WantedBy=default.target
