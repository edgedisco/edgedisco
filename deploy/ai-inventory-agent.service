[Unit]
Description=AI Asset Inventory endpoint collector
After=network-online.target

[Service]
Type=simple
User=root
ExecStart=/opt/ai-inventory/venv/bin/ai-inventory agent run --config /etc/ai-inventory/agent.json
Restart=always
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/etc/ai-inventory

[Install]
WantedBy=multi-user.target
